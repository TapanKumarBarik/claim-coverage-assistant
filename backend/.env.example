# Copy to .env for local development. Never commit .env (it is git-ignored and CI scans for secrets).
APP_ENV=local
LOG_LEVEL=INFO

# --- Option A: bring your own key (default, nothing to set here) --------------------------------------
# Start the app and open Settings in the UI: paste your Azure OpenAI endpoint, key and deployment names.
# The key is held in server memory only, never written to disk or logs.
ALLOW_BYO_CREDENTIALS=true

# --- Option B: server-side Azure OpenAI (private deployments / evals) --------------------------------
# On a PUBLIC instance leave these empty, or anyone can spend your quota.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# Deployment *names* you chose in Azure AI Foundry, not model names.
# AZURE_OPENAI_REASONING_DEPLOYMENT=      # the thinking model (analysis)
# AZURE_OPENAI_FAST_DEPLOYMENT=           # a small model (greetings, routing); defaults to the reasoning one
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=      # optional; enables semantic retrieval for large contracts
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# REASONING_EFFORT=medium                 # only for reasoning-capable deployments
# Prefer no key at all: sign in with `az login` locally, or use a managed identity in Azure.
# AZURE_OPENAI_API_KEY=

# --- Admin area (off unless a password HASH is set) ---------------------------------------------------
# The server reads this file when it starts: restart it after editing.
#   python -m app.cli admin-token     # prints a password (keep it) and its hash (configure the hash)
# ADMIN_TOKEN_SHA256=
# ADMIN_SESSION_IDLE_TTL_S=1800     # signed out after this long without a request
# ADMIN_SESSION_MAX_AGE_S=28800     # and never later than this after signing in

# --- Saved conversations (questions with personal data masked, answers, likes/dislikes) -----------------
# CONVERSATION_RETENTION_DAYS=30
# CONVERSATION_MAX_RECORDS=2000
# FEEDBACK_RATE_PER_MINUTE=20

# --- Limits (defaults shown) ------------------------------------------------------------------------------
# ANALYZE_RATE_PER_MINUTE=6
# CLIENT_DAILY_TOKEN_BUDGET=60000
# GLOBAL_DAILY_TOKEN_BUDGET=1000000
# ABUSE_STRIKE_LIMIT=3
# ABUSE_LOCKOUT_S=900
# SESSION_IDLE_TTL_S=3600
# MAX_CLAIM_CHARS=2000
# STORAGE_DIR=./data/storage
